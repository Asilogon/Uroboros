              "success": true,
              "output": "# Uroboros Commit Helper\n# Интерактивный помощник создания коммитов по конвенции [X.Y.Z] Описание\n\nparam(\n    [switch]$NoAdd,\n    [switch]$DryRun\n)\n\n$ErrorActionPreference = 'Stop'\n\n# --- Проверка git ---\n$gitCmd = Get-Command git -ErrorAction SilentlyContinue\nif (-not $gitCmd) {\n    $candidates = @(\n        'C:\\Program Files\\Git\\bin\\git.exe',\n        'C:\\Program Files (x86)\\Git\\bin\\git.exe',\n        \"$env:LOCALAPPDATA\\Programs\\Git\\bin\\git.exe\"\n    )\n    foreach ($c in $candidates) {\n        if (Test-Path $c) { $gitCmd = @{ Source = $c }; break }\n    }\n}\nif (-not $gitCmd) {\n    Write-Host \"ОШИБКА: Git не найден. Установите Git for Windows.\" -ForegroundColor Red\n    exit 1\n}\n$git = $gitCmd.Source\n\n# --- Переход в корень репозитория ---\n$repoRoot = & $git rev-parse --show-toplevel 2>$null\nif ($LASTEXITCODE -ne 0) {\n    Write-Host \"ОШИБКА: Текущая папка не является git-репозиторием.\" -ForegroundColor Red\n    Write-Host \"Инициализируйте: git init\" -ForegroundColor Yellow\n    exit 1\n}\nPush-Location $repoRoot\ntry {\n    Write-Host \"\"\n    Write-Host \"=== Uroboros Commit Helper ===\" -ForegroundColor Cyan\n    Write-Host \"Репозиторий: $repoRoot\" -ForegroundColor DarkGray\n    Write-Host \"\"\n\n    # --- Показать изменения ---\n    $status = & $git status --short\n    if (-not $status) {\n        Write-Host \"Нет изменений для коммита.\" -ForegroundColor Yellow\n        exit 0\n    }\n    Write-Host \"Изменённые файлы:\" -ForegroundColor Green\n    $status | ForEach-Object { Write-Host \"  $_\" }\n    Write-Host \"\"\n\n    # --- Ввод версии ---\n    do {\n        $ver = Read-Host \"Версия (SemVer, например 0.2.0)\"\n        $ver = $ver.Trim().TrimStart('v')\n        if ($ver -match '^\\d+\\.\\d+\\.\\d+$') { break }\n        Write-Host \"  Формат должен быть X.Y.Z (только цифры и точки).\" -ForegroundColor Red\n    } while ($true)\n\n    # --- Краткое описание ---\n    do {\n        $subject = Read-Host \"Краткое описание (до 72 символов)\"\n        $subject = $subject.Trim().TrimEnd('.')\n        if ($subject.Length -gt 0 -and $subject.Length -le 72) { break }\n        Write-Host \"  Описание должно быть от 1 до 72 символов.\" -ForegroundColor Red\n    } while ($true)\n\n    # --- Подробные изменения ---\n    Write-Host \"\"\n    Write-Host \"Подробные изменения (по одному пункту, пустая строка — завершить):\" -ForegroundColor Green\n    $bullets = @()\n    while ($true) {\n        $line = Read-Host \"  -\"\n        if ([string]::IsNullOrWhiteSpace($line)) { break }\n        $bullets += $line.Trim()\n    }\n\n    # --- Сборка сообщения ---\n    $msg = \"[$ver] $subject\"\n    if ($bullets.Count -gt 0) {\n        $msg += \"`n`nПодробные изменения:`n\"\n        foreach ($b in $bullets) { $msg += \"- $b`n\" }\n        $msg = $msg.TrimEnd()\n    }\n\n    Write-Host \"\"\n    Write-Host \"--- Итоговое сообщение коммита ---\" -ForegroundColor Cyan\n    Write-Host $msg\n    Write-Host \"----------------------------------\" -ForegroundColor Cyan\n\n    if ($DryRun) {\n        Write-Host \"[DryRun] Коммит не создан.\" -ForegroundColor Yellow\n        exit 0\n    }\n\n    $confirm = Read-Host \"Создать коммит? (y/N)\"\n    if ($confirm -notmatch '^[yYдД]') {\n        Write-Host \"Отменено.\" -ForegroundColor Yellow\n        exit 0\n    }\n\n    # --- git add ---\n    if (-not $NoAdd) {\n        & $git add -A\n        if ($LASTEXITCODE -ne 0) { throw \"git add завершился с ошибкой\" }\n    }\n\n    # --- git commit (многострочное сообщение через файл) ---\n    $tmpFile = [System.IO.Path]::GetTempFileName()\n    try {\n        Set-Content -Path $tmpFile -Value $msg -Encoding UTF8\n        & $git commit -F $tmpFile\n        if ($LASTEXITCODE -ne 0) { throw \"git commit завершился с ошибкой\" }\n        Write-Host \"\"\n        Write-Host \"Коммит успешно создан.\" -ForegroundColor Green\n        & $git log -1 --oneline\n    } finally {\n        Remove-Item $tmpFile -ErrorAction SilentlyContinue\n    }\n} finally {\n    Pop-Location\n}\n"
